[Unit]
Description=Radar Frame
After=network.target

[Service]
Type=simple
User=radar-frame
Group=radar-frame
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/radar-frame/server
ExecStart=/opt/radar-frame/server/venv/bin/gunicorn --timeout 90 --log-level=info -b 0.0.0.0:8000 "main:create_server()"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
